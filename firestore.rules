rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'staff' || getUserData().role == 'admin')
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if true; // Allow customers to submit doorstep pickup requests
      allow update: if isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // Payouts Collection
    match /payouts/{payoutId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Scrap Categories (Publicly readable for customer rates)
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Service Areas (Publicly readable)
    match /service_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
