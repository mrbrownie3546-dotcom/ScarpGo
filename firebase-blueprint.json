{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation for customers, staff, and admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "full_name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["customer", "staff", "admin"] },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role"]
    },
    "PickupRequest": {
      "title": "PickupRequest",
      "description": "Scrap pickup request created by customer and assigned to staff driver",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["pending", "assigned", "in_progress", "completed", "cancelled"] },
        "totalEstimatedValue": { "type": "number" },
        "scheduledDate": { "type": "string", "maxLength": 64 },
        "assignedStaffId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerId", "address", "status"]
    },
    "ScrapCategory": {
      "title": "ScrapCategory",
      "description": "Categories and rates for scrap items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "ratePerKg": { "type": "number" },
        "unit": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "ratePerKg"]
    },
    "OtpVerification": {
      "title": "OtpVerification",
      "description": "Verification OTP for email registration / password reset",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "code": { "type": "string", "maxLength": 16 },
        "expiresAt": { "type": "number" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email", "code", "expiresAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection indexed by Firebase Auth UID"
    },
    "/pickup_requests/{requestId}": {
      "schema": { "$ref": "#/entities/PickupRequest" },
      "description": "Pickup requests created by users and processed by staff drivers"
    },
    "/scrap_categories/{categoryId}": {
      "schema": { "$ref": "#/entities/ScrapCategory" },
      "description": "Scrap categories and current per kg rates"
    },
    "/otp_verifications/{docId}": {
      "schema": { "$ref": "#/entities/OtpVerification" },
      "description": "OTP verification codes for account setup and password resets"
    }
  }
}
