rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: sab kuch band
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Role helpers (appUsers/{uid} doc me 'role' hota hai) ----
    function isSignedIn() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.role;
    }
    function hasRoleDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/appUsers/$(request.auth.uid));
    }
    function isAdmin() {
      return hasRoleDoc() && userRole() == 'admin';
    }
    function isStaffOrAdmin() {
      return hasRoleDoc() && (userRole() == 'admin' || userRole() == 'staff');
    }

    // ---- P1-3: Public create validators ----
    // Guest booking sirf sahi fields + sahi values ke saath banegi.
    // Junk/probe docs (jaise {"x": "tampered"}) ab reject honge.
    function isValidNewBooking() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'booking_number', 'customer_id', 'customer_name', 'customer_phone',
          'staff_id', 'staff_name', 'pickup_address', 'pickup_landmark',
          'latitude', 'longitude', 'preferred_date', 'preferred_time_slot',
          'category_ids', 'expected_scrap_items', 'estimated_weight_kg',
          'notify_whatsapp', 'status', 'pickup_otp', 'otp_verified',
          'payout_method', 'upi_id', 'upi_qr_url', 'bank_details',
          'payout_status', 'created_at', 'updated_at'
        ])
        && d.keys().hasAll([
          'id', 'booking_number', 'customer_id', 'customer_name', 'customer_phone',
          'staff_id', 'staff_name', 'pickup_address', 'latitude', 'longitude',
          'preferred_date', 'preferred_time_slot', 'category_ids',
          'expected_scrap_items', 'estimated_weight_kg', 'notify_whatsapp',
          'status', 'pickup_otp', 'otp_verified', 'payout_method',
          'payout_status', 'created_at', 'updated_at'
        ])
        && d.id is string && d.id.size() <= 40
        && d.booking_number is string && d.booking_number.matches('^SH-[A-Z0-9]{5,10}$')
        && d.customer_id is string && d.customer_id.size() <= 60
        && d.customer_name is string && d.customer_name.size() >= 2 && d.customer_name.size() <= 80
        && d.customer_phone is string && d.customer_phone.size() >= 10 && d.customer_phone.size() <= 16
        // Nayi booking khud staff assign nahi kar sakti
        && d.staff_id == null && d.staff_name == null
        && d.pickup_address is string && d.pickup_address.size() >= 5 && d.pickup_address.size() <= 300
        && (!d.keys().hasAny(['pickup_landmark']) || (d.pickup_landmark is string && d.pickup_landmark.size() <= 200))
        && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
        && d.preferred_date is string && d.preferred_date.size() <= 20
        && d.preferred_time_slot is string && d.preferred_time_slot.size() <= 40
        && d.category_ids is list && d.category_ids.size() <= 20
        && d.expected_scrap_items is string && d.expected_scrap_items.size() <= 500
        && d.estimated_weight_kg is number && d.estimated_weight_kg >= 0 && d.estimated_weight_kg <= 100000
        && d.notify_whatsapp is bool
        && d.status == 'pending'
        && d.pickup_otp is string && d.pickup_otp.matches('^[0-9]{4}$')
        && d.otp_verified == false
        && d.payout_method in ['cash', 'upi', 'bank_transfer']
        && (!d.keys().hasAny(['upi_id']) || (d.upi_id is string && d.upi_id.size() <= 60))
        && (!d.keys().hasAny(['upi_qr_url']) || d.upi_qr_url is string)
        && (!d.keys().hasAny(['bank_details']) || (
             d.bank_details is map
             && d.bank_details.keys().hasOnly(['account_number', 'ifsc_code', 'account_holder'])
             && d.bank_details.keys().hasAll(['account_number', 'ifsc_code', 'account_holder'])
             && d.bank_details.account_number is string && d.bank_details.account_number.size() <= 25
             && d.bank_details.ifsc_code is string && d.bank_details.ifsc_code.size() <= 15
             && d.bank_details.account_holder is string && d.bank_details.account_holder.size() <= 80
           ))
        && d.payout_status == 'pending_approval'
        && d.created_at is string && d.created_at.size() <= 40
        && d.updated_at is string && d.updated_at.size() <= 40;
    }

    // Tracking mirror: sirf safe status fields + phone ka SHA-256 hash.
    // Plain phone / address / OTP / UPI likhna ab impossible.
    function isValidNewTracking(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'booking_number', 'phone_hash', 'status', 'payout_status',
          'staff_name', 'staff_vehicle', 'expected_scrap_items', 'category_ids',
          'estimated_weight_kg', 'final_weight_kg', 'final_amount',
          'items_collected', 'payout_method', 'updated_at'
        ])
        && d.keys().hasAll(['booking_number', 'phone_hash', 'status', 'updated_at'])
        // Sensitive fields kabhi nahi
        && !d.keys().hasAny(['customer_phone', 'customer_name', 'pickup_address',
            'pickup_landmark', 'pickup_otp', 'otp_verified', 'upi_id',
            'upi_qr_url', 'bank_details', 'latitude', 'longitude'])
        // Doc id aur booking_number same hona chahiye
        && d.booking_number is string && d.booking_number == docId
        && d.booking_number.size() >= 4 && d.booking_number.size() <= 20
        && d.phone_hash is string && d.phone_hash.size() == 64
        && d.status in ['pending', 'assigned', 'on_the_way', 'arrived', 'weighing', 'completed', 'cancelled']
        && (!d.keys().hasAny(['payout_status']) || d.payout_status in ['pending_approval', 'approved', 'processing', 'successful', 'failed'])
        && (!d.keys().hasAny(['staff_name']) || (d.staff_name is string && d.staff_name.size() <= 80))
        && (!d.keys().hasAny(['staff_vehicle']) || (d.staff_vehicle is string && d.staff_vehicle.size() <= 40))
        && (!d.keys().hasAny(['expected_scrap_items']) || (d.expected_scrap_items is string && d.expected_scrap_items.size() <= 500))
        && (!d.keys().hasAny(['category_ids']) || (d.category_ids is list && d.category_ids.size() <= 20))
        && (!d.keys().hasAny(['estimated_weight_kg']) || d.estimated_weight_kg == null || d.estimated_weight_kg is number)
        && (!d.keys().hasAny(['final_weight_kg']) || d.final_weight_kg == null || d.final_weight_kg is number)
        && (!d.keys().hasAny(['final_amount']) || d.final_amount == null || d.final_amount is number)
        && (!d.keys().hasAny(['items_collected']) || d.items_collected == null || d.items_collected is list)
        && (!d.keys().hasAny(['payout_method']) || (d.payout_method is string && d.payout_method.size() <= 20))
        && d.updated_at is string && d.updated_at.size() <= 40;
    }

    // ---- Roles: admin likhta hai, user apna doc padh sakta hai ----
    // Pehla admin doc Firebase console se manually banta hai (bootstrap).
    match /appUsers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---- Staff profiles: admin manage karta hai, staff apna padh sakta hai ----
    match /staffProfiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---- Admin profiles: admin manage, khud read ----
    match /adminProfiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---- Bookings: guest sirf create; read/update sirf staff/admin ----
    // Poori booking me address/UPI/OTP hota hai - public read kabhi nahi.
    match /bookings/{bookingId} {
      allow create: if isValidNewBooking();
      allow read: if isStaffOrAdmin();
      allow update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // ---- Public tracking mirror: sirf SAFE status fields + phone hash ----
    // Guest Track Status yahi se chalti hai (getDoc by booking number).
    // GET khula hai par LIST band - koi saari bookings ek saath dump nahi kar sakta.
    // Plain customer phone kabhi nahi - sirf SHA-256 hash (P1-4).
    match /tracking/{bookingNumber} {
      allow get: if true;
      allow list: if false;
      // Guest apni nayi booking ka pehla mirror doc create kar sakta hai,
      // par sirf validated safe fields + phone hash ke saath.
      // Status badalna sirf Firebase-se logged-in staff/admin kar sakta hai.
      allow create: if isValidNewTracking(bookingNumber);
      allow update: if isStaffOrAdmin();
      allow delete: if false;
    }

    // ---- Tickets/complaints: guest sirf create; read/update sirf admin ----
    match /tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Reviews: public read + create ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ---- FAQ: public read only ----
    match /faq/{faqId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Rates/categories & service areas: public read only ----
    match /categories/{catId} {
      allow read: if true;
      allow write: if false;
    }
    match /service_areas/{areaId} {
      allow read: if true;
      allow write: if false;
    }

    // users / payouts / audit_logs: default deny (abhi use nahi hote)
  }
}


