rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: sab kuch band
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Role helpers (appUsers/{uid} doc me 'role' hota hai) ----
    function isSignedIn() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.role;
    }
    function hasRoleDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/appUsers/$(request.auth.uid));
    }
    function isAdmin() {
      return hasRoleDoc() && userRole() == 'admin';
    }
    function isStaffOrAdmin() {
      return hasRoleDoc() && (userRole() == 'admin' || userRole() == 'staff');
    }

    // ---- Roles: admin likhta hai, user apna doc padh sakta hai ----
    // Pehla admin doc Firebase console se manually banta hai (bootstrap).
    match /appUsers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---- Staff profiles: admin manage karta hai, staff apna padh sakta hai ----
    match /staffProfiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---- Admin profiles: admin manage, khud read ----
    match /adminProfiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---- Bookings: guest sirf create; read/update sirf staff/admin ----
    // Poori booking me address/UPI/OTP hota hai - public read kabhi nahi.
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if isStaffOrAdmin();
      allow update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // ---- Public tracking mirror: sirf SAFE status fields ----
    // Guest Track Status yahi se chalti hai (getDoc by booking number).
    // GET khula hai par LIST band - koi saari bookings ek saath dump nahi kar sakta.
    // Kabhi sensitive data mat daalo.
    match /tracking/{bookingNumber} {
      allow get: if true;
      allow list: if false;
      // Guest apni nayi booking ka pehla mirror doc create kar sakta hai,
      // par status badalna sirf Firebase-se logged-in staff/admin kar sakta hai.
      allow create: if true;
      allow update: if isStaffOrAdmin();
      allow delete: if false;
    }

    // ---- Tickets/complaints: guest sirf create; read/update sirf admin ----
    match /tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Reviews: public read + create ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ---- FAQ: public read only ----
    match /faq/{faqId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Rates/categories & service areas: public read only ----
    match /categories/{catId} {
      allow read: if true;
      allow write: if false;
    }
    match /service_areas/{areaId} {
      allow read: if true;
      allow write: if false;
    }

    // users / payouts / audit_logs: default deny (abhi use nahi hote)
  }
}

